<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
  </PropertyGroup>
  
  <PropertyGroup>
    <Version>0.0.1-alpha</Version>
    <Title>PipeLoom</Title>
    <Product>PipeLoom</Product>
    <Copyright>Copyright © 2026 PipeLoom Contributors</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>

    <Description>PipeLoom is a data pipe executor framework.</Description>

    <!-- Packaging -->
    <PackageId>PipeLoom</PackageId>

    <Authors>PipeLoom Contributors</Authors>
    <Company>PipeLoom</Company>
    <Product>PipeLoom</Product>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bowlerhats/pipeloom</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>readme.md</PackageReadmeFile>

    <PackageTags>datapipe pipe executor engine jsonquery</PackageTags>

    <IsPackable>true</IsPackable>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" PrivateAssets="compile;analyzers" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" PrivateAssets="compile;analyzers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PipeLoom.Analyzers\PipeLoom.Analyzers.csproj" 
                      OutputItemType="Analyzer" 
                      ReferenceOutputAssembly="false"    />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Engine\Errors\" />
  </ItemGroup>

</Project>
